<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RK Fact | Study Fact Platform - Raja Khan</title>
  
  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            orbitron: ['Orbitron', 'sans-serif'],
            rajdhani: ['Rajdhani', 'sans-serif'],
            sans: ['Space Grotesk', 'sans-serif'],
          },
          colors: {
            cosmic: {
              900: '#030712',
              800: '#0b1329',
              700: '#111d40',
              accent: '#38bdf8',
              nepal: '#dc2626',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #030712;
      color: #f3f4f6;
      overflow-x: hidden;
    }
    .neon-border {
      border: 1px solid rgba(56, 189, 248, 0.3);
      box-shadow: 0 0 15px rgba(56, 189, 248, 0.15);
    }
    .neon-border:hover {
      border-color: rgba(56, 189, 248, 0.8);
      box-shadow: 0 0 25px rgba(56, 189, 248, 0.35);
    }
    .glass-panel {
      background: rgba(11, 19, 41, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    /* Orbit animations */
    @keyframes orbit-cw {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .orbit-ring {
      border: 1px dashed rgba(56, 189, 248, 0.2);
      border-radius: 50%;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
  </style>
</head>
<body class="font-sans antialiased selection:bg-cyan-500 selection:text-black">

  <!-- Background Decorative Canvas & Gradients -->
  <div class="fixed inset-0 pointer-events-none z-0">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-950/40 via-gray-950 to-black"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-cyan-600/10 blur-[140px] rounded-full"></div>
  </div>

  <!-- Navigation -->
  <header class="sticky top-0 z-50 glass-panel border-b border-cyan-500/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-tr from-cyan-500 to-indigo-600 flex items-center justify-center font-orbitron font-bold text-black text-xl shadow-lg shadow-cyan-500/30">
          RK
        </div>
        <div>
          <span class="font-orbitron font-extrabold text-2xl tracking-wider bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">RK FACT</span>
          <span class="block text-[10px] tracking-widest text-gray-400 uppercase font-rajdhani">Cosmic Knowledge Base • Nepal</span>
        </div>
      </div>

      <nav class="hidden md:flex items-center space-x-8 font-rajdhani font-semibold tracking-wider text-sm">
        <a href="#solar-system" class="hover:text-cyan-400 transition-colors">SOLAR SYSTEM</a>
        <a href="#library" class="hover:text-cyan-400 transition-colors">FACT LIBRARY</a>
        <a href="#ai-video" class="hover:text-cyan-400 transition-colors">AI TUTOR</a>
        <a href="#chat-community" class="hover:text-cyan-400 transition-colors">PEER CHAT</a>
        <a href="#membership" class="hover:text-cyan-400 transition-colors">PAYMENT PORTAL</a>
      </nav>

      <div class="flex items-center space-x-3">
        <a href="https://wa.me/9779713268510" target="_blank" class="flex items-center space-x-2 bg-emerald-600 hover:bg-emerald-500 text-white font-rajdhani font-bold px-4 py-2 rounded-lg text-sm transition-all shadow-lg shadow-emerald-600/20">
          <i data-lucide="message-circle" class="w-4 h-4"></i>
          <span>WHATSAPP</span>
        </a>
      </div>
    </div>
  </header>

  <main class="relative z-10">

    <!-- HERO SECTION -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center space-x-2 bg-cyan-950/60 border border-cyan-500/40 px-3.5 py-1.5 rounded-full text-xs font-rajdhani uppercase tracking-widest text-cyan-300">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>Next-Gen Fact Exploration Platform</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-orbitron font-black leading-tight text-white">
          DISCOVER TRUTHS BEYOND THE <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">COSMOS</span>.
        </h1>
        
        <p class="text-gray-300 text-base sm:text-lg leading-relaxed max-w-xl">
          Welcome to RK Fact, created by <strong class="text-cyan-300 font-semibold">Raja Khan</strong> from Nepal. We explore astrophysics, deep scientific facts, and universe mechanics through interactive AI video tutoring and structured digital fact libraries.
        </p>

        <div class="flex flex-wrap gap-4 pt-2">
          <a href="#solar-system" class="px-6 py-3.5 bg-cyan-500 hover:bg-cyan-400 text-black font-orbitron font-bold rounded-lg text-sm tracking-wide shadow-lg shadow-cyan-500/25 transition-all">
            LAUNCH EXPLORER
          </a>
          <a href="#membership" class="px-6 py-3.5 border border-cyan-500/50 hover:bg-cyan-500/10 font-orbitron font-semibold text-cyan-300 rounded-lg text-sm tracking-wide transition-all">
            UPGRADE ACCESS
          </a>
        </div>

        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-gray-800">
          <div>
            <div class="font-orbitron font-bold text-2xl text-cyan-400">1,400+</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider font-rajdhani">Archived Facts</div>
          </div>
          <div>
            <div class="font-orbitron font-bold text-2xl text-cyan-400">24/7</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider font-rajdhani">AI Fact Voice</div>
          </div>
          <div>
            <div class="font-orbitron font-bold text-2xl text-cyan-400">Nepal</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider font-rajdhani">Kathmandu Hub</div>
          </div>
        </div>
      </div>

      <!-- Founder Card with Uploaded Photo -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative group w-full max-w-md">
          <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-2xl blur-lg opacity-40 group-hover:opacity-75 transition duration-500"></div>
          <div class="relative rounded-2xl glass-panel neon-border overflow-hidden p-3">
            <div class="relative h-96 w-full rounded-xl overflow-hidden bg-gray-900">
              <img src="image.png" alt="Raja Khan - Founder of RK Fact" class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105" onerror="this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?fit=crop&w=800&q=80'">
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
              
              <div class="absolute bottom-4 left-4 right-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-orbitron font-bold text-xl text-white">Raja Khan</h3>
                    <p class="text-xs font-rajdhani tracking-widest text-cyan-400 uppercase">Founder & Head Researcher</p>
                  </div>
                  <span class="inline-flex items-center text-xs bg-cyan-950/80 border border-cyan-400/50 px-2.5 py-1 rounded-md text-cyan-300 font-rajdhani">
                    🇳🇵 Nepal
                  </span>
                </div>
                <div class="mt-3 pt-3 border-t border-cyan-500/20 flex items-center justify-between text-xs text-gray-400 font-rajdhani">
                  <span>Direct: +977 9713268510</span>
                  <span class="text-emerald-400 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Verified ID
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 1: SOLAR SYSTEM INTERACTIVE EXPLORER -->
    <section id="solar-system" class="py-20 border-t border-cyan-900/40 bg-black/40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="font-orbitron font-bold text-3xl sm:text-4xl text-white">SOLAR SYSTEM ENGINE</h2>
          <p class="text-gray-400 font-rajdhani text-base tracking-wider mt-2">Select a celestial body to inspect its properties and listen to fact synthesis.</p>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-4 flex flex-col space-y-3">
            <button onclick="selectPlanet('sun')" class="planet-btn active text-left p-4 rounded-xl glass-panel neon-border transition flex items-center justify-between" data-id="sun">
              <span class="font-orbitron font-bold">☀️ Sun (The Star)</span>
              <span class="text-xs text-cyan-400 font-rajdhani">5,500°C</span>
            </button>
            <button onclick="selectPlanet('mercury')" class="planet-btn text-left p-4 rounded-xl glass-panel border border-gray-800 hover:border-cyan-500/40 transition flex items-center justify-between" data-id="mercury">
              <span class="font-orbitron font-bold">🌑 Mercury</span>
              <span class="text-xs text-gray-400 font-rajdhani">430°C / -180°C</span>
            </button>
            <button onclick="selectPlanet('earth')" class="planet-btn text-left p-4 rounded-xl glass-panel border border-gray-800 hover:border-cyan-500/40 transition flex items-center justify-between" data-id="earth">
              <span class="font-orbitron font-bold">🌍 Earth</span>
              <span class="text-xs text-emerald-400 font-rajdhani">Habitable</span>
            </button>
            <button onclick="selectPlanet('mars')" class="planet-btn text-left p-4 rounded-xl glass-panel border border-gray-800 hover:border-cyan-500/40 transition flex items-center justify-between" data-id="mars">
              <span class="font-orbitron font-bold">🔴 Mars (Red Planet)</span>
              <span class="text-xs text-amber-500 font-rajdhani">-65°C</span>
            </button>
            <button onclick="selectPlanet('jupiter')" class="planet-btn text-left p-4 rounded-xl glass-panel border border-gray-800 hover:border-cyan-500/40 transition flex items-center justify-between" data-id="jupiter">
              <span class="font-orbitron font-bold">🪐 Jupiter</span>
              <span class="text-xs text-indigo-400 font-rajdhani">Gas Giant</span>
            </button>
          </div>

          <!-- Dynamic Planet Card -->
          <div class="lg:col-span-8 glass-panel neon-border p-8 rounded-2xl relative overflow-hidden">
            <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-cyan-500/20 pb-6 mb-6">
              <div>
                <h3 id="planet-name" class="font-orbitron font-black text-3xl text-cyan-300">SUN</h3>
                <p id="planet-subtitle" class="text-gray-400 font-rajdhani uppercase text-sm tracking-widest">Type: G-Type Main-Sequence Star</p>
              </div>
              <button onclick="speakCurrentFact()" class="inline-flex items-center space-x-2 bg-cyan-500/20 hover:bg-cyan-500/40 text-cyan-300 px-4 py-2 rounded-lg font-rajdhani font-bold text-sm transition">
                <i data-lucide="volume-2" class="w-4 h-4"></i>
                <span>LISTEN TO FACT</span>
              </button>
            </div>

            <p id="planet-fact" class="text-lg text-gray-200 leading-relaxed mb-8">
              The Sun holds 99.86% of all mass in the Solar System. Inside its core, nuclear fusion transforms roughly 600 million tons of hydrogen into helium every single second, sustaining light for our entire planetary neighborhood.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-gray-800">
              <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-800">
                <span class="block text-xs font-rajdhani text-gray-400 uppercase">Core Temp</span>
                <span id="planet-temp" class="font-orbitron font-bold text-cyan-400 text-sm sm:text-base">15,000,000°C</span>
              </div>
              <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-800">
                <span class="block text-xs font-rajdhani text-gray-400 uppercase">Gravity</span>
                <span id="planet-gravity" class="font-orbitron font-bold text-cyan-400 text-sm sm:text-base">274 m/s²</span>
              </div>
              <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-800">
                <span class="block text-xs font-rajdhani text-gray-400 uppercase">Orbit Period</span>
                <span id="planet-orbit" class="font-orbitron font-bold text-cyan-400 text-sm sm:text-base">230 Million Yrs</span>
              </div>
              <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-800">
                <span class="block text-xs font-rajdhani text-gray-400 uppercase">Moons</span>
                <span id="planet-moons" class="font-orbitron font-bold text-cyan-400 text-sm sm:text-base">0 (8 Planets)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: DIGITAL FACT LIBRARY -->
    <section id="library" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12">
        <div>
          <h2 class="font-orbitron font-bold text-3xl sm:text-4xl text-white">CURATED FACT ARCHIVE</h2>
          <p class="text-gray-400 font-rajdhani text-base tracking-wider mt-1">Exploration manuals, physics papers, and verified cosmic phenomena.</p>
        </div>
        <div class="w-full md:w-72">
          <input type="text" id="factSearch" onkeyup="filterBooks()" placeholder="Search astronomy facts..." class="w-full px-4 py-2.5 rounded-lg bg-gray-900/80 border border-cyan-500/30 focus:border-cyan-400 focus:outline-none text-sm font-sans placeholder-gray-500">
        </div>
      </div>

      <div id="booksGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="book-card glass-panel neon-border p-6 rounded-xl flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <span class="text-xs font-orbitron text-cyan-400 bg-cyan-950/80 px-2.5 py-1 rounded">ASTROPHYSICS</span>
              <span class="text-xs text-gray-400 font-rajdhani">Vol. 104</span>
            </div>
            <h4 class="font-orbitron font-bold text-lg text-white mb-2">Relativity & Black Hole Horizons</h4>
            <p class="text-gray-400 text-sm leading-relaxed">
              Why time dilates to near infinity at the event horizon of a supermassive black hole, and how light can never escape its tidal pull.
            </p>
          </div>
          <button onclick="alert('Full Fact Sheet unlocked for Raja Khan study network!')" class="mt-6 w-full py-2 bg-gray-800 hover:bg-cyan-500/20 text-cyan-300 font-rajdhani font-bold text-sm tracking-wider rounded border border-cyan-500/30 transition">
            READ EXCERPT
          </button>
        </div>

        <!-- Card 2 -->
        <div class="book-card glass-panel neon-border p-6 rounded-xl flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <span class="text-xs font-orbitron text-cyan-400 bg-cyan-950/80 px-2.5 py-1 rounded">DEEP SPACE</span>
              <span class="text-xs text-gray-400 font-rajdhani">Vol. 219</span>
            </div>
            <h4 class="font-orbitron font-bold text-lg text-white mb-2">The Oort Cloud Mystery</h4>
            <p class="text-gray-400 text-sm leading-relaxed">
              Billions of icy planetesimals lingering nearly a light-year away from our Sun, defining the actual gravitational boundary of the solar system.
            </p>
          </div>
          <button onclick="alert('Full Fact Sheet unlocked for Raja Khan study network!')" class="mt-6 w-full py-2 bg-gray-800 hover:bg-cyan-500/20 text-cyan-300 font-rajdhani font-bold text-sm tracking-wider rounded border border-cyan-500/30 transition">
            READ EXCERPT
          </button>
        </div>

        <!-- Card 3 -->
        <div class="book-card glass-panel neon-border p-6 rounded-xl flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-center mb-4">
              <span class="text-xs font-orbitron text-cyan-400 bg-cyan-950/80 px-2.5 py-1 rounded">QUANTUM</span>
              <span class="text-xs text-gray-400 font-rajdhani">Vol. 308</span>
            </div>
            <h4 class="font-orbitron font-bold text-lg text-white mb-2">Quantum Entanglement Waves</h4>
            <p class="text-gray-400 text-sm leading-relaxed">
              Einstein called it 'spooky action at a distance'—twin particles instantly reacting across millions of light-years simultaneously.
            </p>
          </div>
          <button onclick="alert('Full Fact Sheet unlocked for Raja Khan study network!')" class="mt-6 w-full py-2 bg-gray-800 hover:bg-cyan-500/20 text-cyan-300 font-rajdhani font-bold text-sm tracking-wider rounded border border-cyan-500/30 transition">
            READ EXCERPT
          </button>
        </div>
      </div>
    </section>

    <!-- SECTION 3: VIDEO CALL WITH AI -->
    <section id="ai-video" class="py-20 border-t border-cyan-900/40 bg-gradient-to-b from-gray-950 via-black to-gray-950">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <span class="text-xs font-rajdhani tracking-widest text-cyan-400 uppercase font-semibold">Interactive Study Assistant</span>
          <h2 class="font-orbitron font-bold text-3xl sm:text-4xl text-white mt-1">VIDEO CALL WITH COSMO AI</h2>
          <p class="text-gray-400 font-rajdhani text-base tracking-wider mt-2">Engage in dynamic science discussions and vocalized study answers.</p>
        </div>

        <div class="glass-panel neon-border rounded-2xl overflow-hidden p-6 sm:p-8">
          <div class="relative aspect-video w-full bg-gray-950 rounded-xl overflow-hidden flex items-center justify-center border border-cyan-500/30">
            <!-- AI Avatar / Holographic Visualizer -->
            <div class="text-center space-y-4">
              <div class="w-24 h-24 mx-auto rounded-full bg-cyan-500/10 border-2 border-cyan-400 flex items-center justify-center animate-pulse">
                <i data-lucide="bot" class="w-12 h-12 text-cyan-400"></i>
              </div>
              <div>
                <h4 class="font-orbitron font-bold text-white text-lg">COSMO AI 5.0</h4>
                <p id="ai-status" class="text-xs font-rajdhani text-cyan-300 tracking-wider">ONLINE • READY FOR SCIENTIFIC INQUIRY</p>
              </div>
            </div>

            <!-- Call HUD Overlay -->
            <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md px-3 py-1 rounded text-xs font-rajdhani text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span> LIVE SESSION
            </div>

            <div class="absolute bottom-4 left-4 right-4 flex justify-center items-center space-x-4">
              <button onclick="triggerVoiceQuery('Explain quantum mechanics in 10 seconds')" class="bg-gray-900/90 hover:bg-gray-800 text-xs text-cyan-300 font-rajdhani px-3 py-2 rounded-lg border border-cyan-500/30">
                Ask: Quantum In 10s
              </button>
              <button onclick="triggerVoiceQuery('Why is Jupiter important for Earth?')" class="bg-gray-900/90 hover:bg-gray-800 text-xs text-cyan-300 font-rajdhani px-3 py-2 rounded-lg border border-cyan-500/30">
                Ask: Jupiter Guard Shield
              </button>
              <button onclick="endCall()" class="bg-red-600 hover:bg-red-500 p-2.5 rounded-full text-white">
                <i data-lucide="phone-off" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <div id="ai-response-box" class="mt-6 p-4 rounded-xl bg-gray-900/80 border border-cyan-500/20 text-gray-300 text-sm">
            <span class="font-bold text-cyan-400">Cosmo AI:</span> "Hello! I am your AI study mentor on RK Fact. Ask me any astronomy or general science question or tap the prompts above to initiate audio explanation!"
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: PEER STUDY CHAT -->
    <section id="chat-community" class="py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="font-orbitron font-bold text-3xl sm:text-4xl text-white">COMMUNITY STUDY ROOM</h2>
        <p class="text-gray-400 font-rajdhani text-base tracking-wider mt-1">Collaborate with fellow students and share science inquiries.</p>
      </div>

      <div class="glass-panel neon-border rounded-2xl p-6 flex flex-col h-[480px]">
        <div id="chatMessages" class="flex-1 overflow-y-auto space-y-4 pr-2">
          <div class="bg-cyan-950/40 p-3 rounded-lg border border-cyan-500/20 max-w-md">
            <span class="text-xs font-orbitron text-cyan-400">Raja Khan (Founder)</span>
            <p class="text-sm text-gray-200 mt-1">Welcome to the official RK Fact chat room! Feel free to ask any science or astronomy question here.</p>
          </div>
          <div class="bg-gray-900/60 p-3 rounded-lg border border-gray-800 max-w-md ml-auto">
            <span class="text-xs font-orbitron text-gray-400">Student • Pokhara</span>
            <p class="text-sm text-gray-200 mt-1">Does the Voyager 1 probe still transmit data to Earth from interstellar space?</p>
          </div>
          <div class="bg-cyan-950/40 p-3 rounded-lg border border-cyan-500/20 max-w-md">
            <span class="text-xs font-orbitron text-cyan-400">Raja Khan (Founder)</span>
            <p class="text-sm text-gray-200 mt-1">Yes! It takes over 22 hours for a radio signal from Voyager 1 to reach NASA's Deep Space Network dishes.</p>
          </div>
        </div>

        <form id="chatForm" onsubmit="handleSendMessage(event)" class="mt-4 flex gap-3 pt-3 border-t border-gray-800">
          <input type="text" id="chatInput" placeholder="Type a message or fact question..." class="flex-1 px-4 py-2.5 rounded-lg bg-gray-900 border border-cyan-500/30 focus:border-cyan-400 focus:outline-none text-sm text-white">
          <button type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-black font-orbitron font-bold px-5 rounded-lg text-sm flex items-center gap-1.5 transition">
            <span>SEND</span>
            <i data-lucide="send" class="w-4 h-4"></i>
          </button>
        </form>
      </div>
    </section>

    <!-- SECTION 5: PAYMENT PORTAL (eSewa, Khalti, Fonepay, NIC ASIA Bank) -->
    <section id="membership" class="py-20 border-t border-cyan-900/40 bg-black/60">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="font-orbitron font-bold text-3xl sm:text-4xl text-white">MEMBERSHIP & DONATION PORTAL</h2>
          <p class="text-gray-400 font-rajdhani text-base tracking-wider mt-2">Support research, unlock unrestricted book downloads, and gain priority AI access.</p>
          
          <!-- Currency Switcher -->
          <div class="mt-6 inline-flex p-1 rounded-xl bg-gray-900 border border-cyan-500/30">
            <button onclick="setCurrency('NPR')" id="btn-npr" class="px-5 py-2 rounded-lg font-orbitron font-bold text-xs bg-cyan-500 text-black transition">NPR (रु)</button>
            <button onclick="setCurrency('INR')" id="btn-inr" class="px-5 py-2 rounded-lg font-orbitron font-bold text-xs text-gray-400 hover:text-white transition">INR (₹)</button>
          </div>
        </div>

        <div class="grid lg:grid-cols-12 gap-8 items-start">
          <!-- Gateway Selector & Payment Details -->
          <div class="lg:col-span-7 space-y-6">
            <div class="glass-panel neon-border p-6 rounded-2xl">
              <h3 class="font-orbitron font-bold text-xl text-white mb-4">Choose Payment Gateway</h3>
              
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                <button onclick="selectGateway('esewa')" class="gw-btn border-2 border-emerald-500 bg-emerald-950/30 p-3 rounded-xl flex flex-col items-center gap-2">
                  <span class="font-bold text-emerald-400 text-sm">eSewa</span>
                  <span class="text-[10px] text-gray-400 font-rajdhani">Nepal Wallet</span>
                </button>
                <button onclick="selectGateway('khalti')" class="gw-btn border border-gray-800 hover:border-purple-500 bg-gray-900/50 p-3 rounded-xl flex flex-col items-center gap-2">
                  <span class="font-bold text-purple-400 text-sm">Khalti</span>
                  <span class="text-[10px] text-gray-400 font-rajdhani">Nepal Digital</span>
                </button>
                <button onclick="selectGateway('fonepay')" class="gw-btn border border-gray-800 hover:border-red-500 bg-gray-900/50 p-3 rounded-xl flex flex-col items-center gap-2">
                  <span class="font-bold text-red-400 text-sm">Fonepay</span>
                  <span class="text-[10px] text-gray-400 font-rajdhani">QR / UPI</span>
                </button>
                <button onclick="selectGateway('nicasia')" class="gw-btn border border-gray-800 hover:border-blue-500 bg-gray-900/50 p-3 rounded-xl flex flex-col items-center gap-2">
                  <span class="font-bold text-blue-400 text-sm">NIC ASIA</span>
                  <span class="text-[10px] text-gray-400 font-rajdhani">Direct Bank</span>
                </button>
              </div>

              <!-- Gateway Active Panel -->
              <div class="bg-gray-950 p-5 rounded-xl border border-cyan-500/20 space-y-3">
                <div class="flex justify-between items-center">
                  <span class="text-xs font-rajdhani text-gray-400 uppercase">Payment Recipient</span>
                  <span class="text-sm font-bold text-cyan-300 font-orbitron">Raja Khan</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-xs font-rajdhani text-gray-400 uppercase">Registered Number</span>
                  <div class="flex items-center space-x-2">
                    <span class="font-orbitron font-bold text-emerald-400">9713268510</span>
                    <button onclick="copyNumber()" class="text-xs bg-gray-800 hover:bg-gray-700 px-2 py-1 rounded text-gray-300 font-rajdhani">COPY</button>
                  </div>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-xs font-rajdhani text-gray-400 uppercase">Gateway Instructions</span>
                  <span id="gateway-inst" class="text-xs text-gray-300 font-sans">Send via eSewa ID: 9713268510</span>
                </div>
              </div>
            </div>

            <!-- Tier Pricing Plans -->
            <div class="grid sm:grid-cols-3 gap-4">
              <div class="glass-panel p-4 rounded-xl border border-gray-800">
                <span class="text-xs font-rajdhani text-gray-400 uppercase">Monthly Scholar</span>
                <div class="text-xl font-orbitron font-bold text-white mt-1" id="price-starter">रु 299</div>
                <p class="text-xs text-gray-400 mt-2">Unlimited Fact Access & Community Chat</p>
              </div>
              <div class="glass-panel p-4 rounded-xl border border-cyan-500/50 bg-cyan-950/20">
                <span class="text-xs font-rajdhani text-cyan-400 uppercase font-bold">Annual Explorer</span>
                <div class="text-xl font-orbitron font-bold text-cyan-300 mt-1" id="price-pro">रु 799</div>
                <p class="text-xs text-gray-400 mt-2">AI Voice Assistant + Complete Library</p>
              </div>
              <div class="glass-panel p-4 rounded-xl border border-gray-800">
                <span class="text-xs font-rajdhani text-gray-400 uppercase">Lifetime Patron</span>
                <div class="text-xl font-orbitron font-bold text-white mt-1" id="price-life">रु 1,499</div>
                <p class="text-xs text-gray-400 mt-2">Direct Mentorship & Video Calls</p>
              </div>
            </div>
          </div>

          <!-- Dynamic QR Code Card -->
          <div class="lg:col-span-5 glass-panel neon-border p-6 rounded-2xl text-center space-y-4">
            <h4 class="font-orbitron font-bold text-lg text-white">SCAN WITH PAYMENT APP</h4>
            <p class="text-xs text-gray-400 font-rajdhani">Compatible with eSewa, Khalti, FonePay, and UPI Apps</p>

            <div class="p-4 bg-white rounded-xl inline-block shadow-2xl">
              <!-- Dynamically generated QR Code using public API -->
              <img id="qrImage" src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=9713268510@upi&pn=RajaKhan&cu=INR" alt="Payment QR Code for 9713268510" class="w-48 h-48 mx-auto">
            </div>

            <p class="text-xs text-gray-300 font-mono">ID / Number: 9713268510</p>

            <a href="https://wa.me/9779713268510?text=Hello%20Raja%20Khan,%20I%20have%20completed%20the%20payment%20on%209713268510%20for%20RK%20Fact%20Membership." target="_blank" class="w-full inline-flex justify-center items-center space-x-2 bg-emerald-600 hover:bg-emerald-500 text-white font-rajdhani font-bold py-3 rounded-lg text-sm transition">
              <i data-lucide="check-circle" class="w-4 h-4"></i>
              <span>CONFIRM PAYMENT ON WHATSAPP</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="glass-panel border-t border-cyan-900/50 py-12 relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <div class="font-orbitron font-extrabold text-lg text-white">RK FACT</div>
        <p class="text-xs text-gray-400 font-rajdhani mt-1">
          Designed & Founded by <strong class="text-cyan-300">Raja Khan</strong> • Kathmandu, Nepal
        </p>
      </div>

      <div class="text-xs text-gray-400 font-rajdhani flex items-center space-x-6">
        <span>Payment ID: 9713268510</span>
        <a href="https://wa.me/9779713268510" target="_blank" class="text-emerald-400 hover:underline">WhatsApp: +977 9713268510</a>
      </div>

      <div class="text-xs text-gray-500 font-rajdhani">
        © 2026 RK FACT. All rights reserved.
      </div>
    </div>
  </footer>

  <!-- JAVASCRIPT LOGIC -->
  <script>
    // Initialize icons
    lucide.createIcons();

    // Planet Database
    const planetData = {
      sun: {
        name: "SUN",
        subtitle: "Type: G-Type Main-Sequence Star",
        fact: "The Sun holds 99.86% of all mass in the Solar System. Inside its core, nuclear fusion transforms roughly 600 million tons of hydrogen into helium every single second.",
        temp: "15,000,000°C",
        gravity: "274 m/s²",
        orbit: "230M Yrs",
        moons: "0 (8 Planets)"
      },
      mercury: {
        name: "MERCURY",
        subtitle: "Type: Terrestrial Planet",
        fact: "Mercury is the smallest planet in the Solar System and experiences the most extreme temperature swings, varying from 430°C in sunlight down to -180°C in the dark.",
        temp: "-180°C to 430°C",
        gravity: "3.7 m/s²",
        orbit: "88 Days",
        moons: "0"
      },
      earth: {
        name: "EARTH",
        subtitle: "Type: Habitable Biosphere",
        fact: "Earth is the only known celestial body in the universe confirmed to harbor organic life, liquid oceans, and a robust magnetic magnetosphere protecting against solar radiation.",
        temp: "14°C (Avg)",
        gravity: "9.8 m/s²",
        orbit: "365.25 Days",
        moons: "1 (Luna)"
      },
      mars: {
        name: "MARS",
        subtitle: "Type: Terrestrial Desert Planet",
        fact: "Mars hosts Olympus Mons, a volcano three times taller than Mount Everest. Evidence shows river valleys and water ice exist beneath its iron oxide-rich surface.",
        temp: "-65°C (Avg)",
        gravity: "3.71 m/s²",
        orbit: "687 Days",
        moons: "2 (Phobos, Deimos)"
      },
      jupiter: {
        name: "JUPITER",
        subtitle: "Type: Gas Giant",
        fact: "Jupiter is two and a half times more massive than all other solar system planets combined, acting as a cosmic vacuum cleaner that shields Earth from asteroid impacts.",
        temp: "-110°C",
        gravity: "24.79 m/s²",
        orbit: "11.86 Yrs",
        moons: "95 Confirmed"
      }
    };

    let currentPlanetKey = 'sun';

    function selectPlanet(key) {
      currentPlanetKey = key;
      const data = planetData[key];
      
      document.getElementById('planet-name').innerText = data.name;
      document.getElementById('planet-subtitle').innerText = data.subtitle;
      document.getElementById('planet-fact').innerText = data.fact;
      document.getElementById('planet-temp').innerText = data.temp;
      document.getElementById('planet-gravity').innerText = data.gravity;
      document.getElementById('planet-orbit').innerText = data.orbit;
      document.getElementById('planet-moons').innerText = data.moons;

      // Update button highlights
      document.querySelectorAll('.planet-btn').forEach(btn => {
        if(btn.dataset.id === key) {
          btn.className = "planet-btn active text-left p-4 rounded-xl glass-panel neon-border transition flex items-center justify-between";
        } else {
          btn.className = "planet-btn text-left p-4 rounded-xl glass-panel border border-gray-800 hover:border-cyan-500/40 transition flex items-center justify-between";
        }
      });
    }

    function speakCurrentFact() {
      const text = document.getElementById('planet-fact').innerText;
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.rate = 0.95;
        window.speechSynthesis.speak(utterance);
      } else {
        alert("Audio synthesis is not supported on this browser.");
      }
    }

    // Book Filter Functionality
    function filterBooks() {
      const term = document.getElementById('factSearch').value.toLowerCase();
      const cards = document.querySelectorAll('.book-card');
      cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        card.style.display = text.includes(term) ? 'flex' : 'none';
      });
    }

    // AI Call Assistant Simulation
    function triggerVoiceQuery(question) {
      const responseBox = document.getElementById('ai-response-box');
      responseBox.innerHTML = `<span class="font-bold text-cyan-400">Cosmo AI:</span> Analyzing query: "<em>${question}</em>"...`;

      setTimeout(() => {
        let answer = "";
        if (question.includes("Quantum")) {
          answer = "Quantum mechanics governs the microscopic universe: particles can exist in superpositions of states until observed, and become instantaneously entangled.";
        } else {
          answer = "Jupiter's enormous gravitational well deflects most incoming comets and asteroids, preserving Earth from frequent mass-extinction events!";
        }
        responseBox.innerHTML = `<span class="font-bold text-cyan-400">Cosmo AI:</span> "${answer}"`;
        
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
          const utterance = new SpeechSynthesisUtterance(answer);
          window.speechSynthesis.speak(utterance);
        }
      }, 700);
    }

    function endCall() {
      document.getElementById('ai-status').innerText = "SESSION PAUSED";
      document.getElementById('ai-response-box').innerHTML = `<span class="font-bold text-gray-400">Cosmo AI:</span> Call session paused. Tap an inquiry button to restart conversation.`;
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
    }

    // Chat room messaging
    function handleSendMessage(e) {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      const text = input.value.trim();
      if (!text) return;

      const container = document.getElementById('chatMessages');
      
      // User message
      const userMsg = document.createElement('div');
      userMsg.className = "bg-gray-900/60 p-3 rounded-lg border border-gray-800 max-w-md ml-auto";
      userMsg.innerHTML = `<span class="text-xs font-orbitron text-gray-400">You (Student)</span><p class="text-sm text-gray-200 mt-1">${text}</p>`;
      container.appendChild(userMsg);
      input.value = "";

      container.scrollTop = container.scrollHeight;

      // Simulated auto-reply from Raja Khan
      setTimeout(() => {
        const founderReply = document.createElement('div');
        founderReply.className = "bg-cyan-950/40 p-3 rounded-lg border border-cyan-500/20 max-w-md";
        founderReply.innerHTML = `<span class="text-xs font-orbitron text-cyan-400">Raja Khan (Nepal)</span><p class="text-sm text-gray-200 mt-1">Thanks for sharing! We will document this insight in our upcoming RK Fact research volume.</p>`;
        container.appendChild(founderReply);
        container.scrollTop = container.scrollHeight;
      }, 1000);
    }

    // Currency Switcher Logic
    function setCurrency(curr) {
      const btnNpr = document.getElementById('btn-npr');
      const btnInr = document.getElementById('btn-inr');
      const qrImg = document.getElementById('qrImage');

      if (curr === 'NPR') {
        btnNpr.className = "px-5 py-2 rounded-lg font-orbitron font-bold text-xs bg-cyan-500 text-black transition";
        btnInr.className = "px-5 py-2 rounded-lg font-orbitron font-bold text-xs text-gray-400 hover:text-white transition";
        document.getElementById('price-starter').innerText = "रु 299";
        document.getElementById('price-pro').innerText = "रु 799";
        document.getElementById('price-life').innerText = "रु 1,499";
        qrImg.src = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=esewa://pay?id=9713268510&am=299";
      } else {
        btnInr.className = "px-5 py-2 rounded-lg font-orbitron font-bold text-xs bg-cyan-500 text-black transition";
        btnNpr.className = "px-5 py-2 rounded-lg font-orbitron font-bold text-xs text-gray-400 hover:text-white transition";
        document.getElementById('price-starter').innerText = "₹ 199";
        document.getElementById('price-pro').innerText = "₹ 499";
        document.getElementById('price-life').innerText = "₹ 999";
        qrImg.src = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=9713268510@upi&pn=RajaKhan&cu=INR";
      }
    }

    // Gateway Selection
    function selectGateway(gw) {
      const inst = document.getElementById('gateway-inst');
      if (gw === 'esewa') {
        inst.innerText = "Send via eSewa ID: 9713268510 (Raja Khan, Nepal)";
      } else if (gw === 'khalti') {
        inst.innerText = "Send via Khalti ID: 9713268510 (Raja Khan)";
      } else if (gw === 'fonepay') {
        inst.innerText = "Scan QR with Fonepay / PhonePe or send to: 9713268510";
      } else if (gw === 'nicasia') {
        inst.innerText = "NIC ASIA Bank Nepal • Acct Name: Raja Khan • Ref/Phone: 9713268510";
      }
    }

    function copyNumber() {
      navigator.clipboard.writeText("9713268510");
      alert("Payment number copied: 9713268510");
    }
  </script>
</body>
</html>
